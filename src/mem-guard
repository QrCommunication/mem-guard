def human_mb(n_bytes):
    return int(n_bytes / (1024 * 1024))


def read_mem():
    """Lecture mémoire/swap depuis /proc/meminfo (compatible avec l'ancien CSV)."""
    info = {}
    with open("/proc/meminfo") as fh:
        for line in fh:
            k, _, rest = line.partition(":")
            info[k] = int(rest.strip().split()[0])  # kB
    mem_total = info["MemTotal"]
    mem_avail = info.get("MemAvailable", info["MemFree"])
    swap_total = info.get("SwapTotal", 0)
    swap_free = info.get("SwapFree", 0)
    mem_pct = (mem_total - mem_avail) * 100 // mem_total
    swap_pct = ((swap_total - swap_free) * 100 // swap_total) if swap_total else 0
    return {
        "mem_pct": mem_pct, "swap_pct": swap_pct,
        "mem_total": mem_total, "swap_total": swap_total,
    }


def window_titles_by_pid():
    """Map PID -> [titres de fenêtres] via wmctrl (X11). Vide si indisponible."""
    titles = {}
    try:
        out = subprocess.run(["wmctrl", "-lp"], capture_output=True,
                             text=True, timeout=2).stdout
    except Exception:
        return titles
    for line in out.splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 5:
            try:
                pid = int(parts[2])
            except ValueError:
                continue
            title = parts[4].strip()
            if title:
                titles.setdefault(pid, []).append(title)
    return titles


def tmux_pane_labels():
    """Map pid_avant-plan -> 'session:fenêtre' pour toutes les sockets tmux.

    Les CLI dans tmux tournent sous un serveur détaché (sans fenêtre X) : tmux
    est la seule source qui sait quel pane contient quoi.
    """
    labels = {}
    if not shutil.which("tmux"):
        return labels
    sockdir = "/tmp/tmux-%d" % os.getuid()
    try:
        socks = os.listdir(sockdir)
    except OSError:
        return labels
    for name in socks:
        try:
            out = subprocess.run(
                ["tmux", "-L", name, "list-panes", "-a", "-F",
                 "#{pane_pid}\t#{session_name}:#{window_name}"],
                capture_output=True, text=True, timeout=2).stdout
        except Exception:
            continue
        for line in out.splitlines():
            pid_s, _, label = line.partition("\t")
            try:
                labels[int(pid_s)] = label.strip()
            except ValueError:
                pass
    return labels


def kitty_pane_labels(kitty_pids):
    """Map pid -> 'onglet › split' via le contrôle distant kitty.

    Indispensable car kitty gère N fenêtres + onglets + splits dans UN process :
    X ne voit que le PID kitty. `kitty @ ls` donne le détail par process
    d'avant-plan. Nécessite allow_remote_control + listen_on (sinon vide).
    """
    labels = {}
    exe = shutil.which("kitty") or shutil.which("kitten")
    if not exe:
        return labels
    seen = set()
    for kp in kitty_pids:
        try:
            with open("/proc/%d/environ" % kp, "rb") as fh:
                env = fh.read().split(b"\0")
        except OSError:
            continue
        addr = None
        for e in env:
            if e.startswith(b"KITTY_LISTEN_ON="):
                addr = e.split(b"=", 1)[1].decode(errors="replace")
                break
        if not addr or addr in seen:
            continue
        seen.add(addr)
        try:
            out = subprocess.run([exe, "@", "--to", addr, "ls"],
                                capture_output=True, text=True, timeout=2).stdout
            data = json.loads(out)
        except Exception:
            continue
        for osw in data:
            for tab in osw.get("tabs", []):
                ttitle = tab.get("title", "")
                for pane in tab.get("windows", []):
                    ptitle = pane.get("title", "")
                    if ptitle and ptitle != ttitle:
                        label = "🐱 %s › %s" % (ttitle, ptitle)
                    else:
                        label = "🐱 %s" % ttitle
                    label = label[:160]
                    pids = set()
                    if pane.get("pid"):
                        pids.add(pane["pid"])
                    for fg in pane.get("foreground_processes", []):
                        if fg.get("pid"):
                            pids.add(fg["pid"])
                    for pp in pids:
                        labels[pp] = label
    return labels


